{
  // Cloudflare Workers config for bladedaywalker.wesponder5.workers.dev
  "name": "bladedaywalker",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CoopRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoopRoom"] }]
}
